        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Main {\n        -scanner: Scanner$\n        -system: RentalSystem$\n        +main(args: String[]) void$\n        -printMenu() void$\n        -handleChoice(choice: int) void$\n        -addVehicle() void$\n        -searchVehicle() void$\n        -registerCustomer() void$\n        -rentVehicle() void$\n        -readText(msg: String) String$\n        -readInt(msg: String) int$\n        -readDouble(msg: String) double$\n        -readYesNo(msg: String) boolean$\n    }\n\n    class RentalSystem {\n        -vehicles: ArrayList~Vehicle~\n        -customers: ArrayList~Customer~\n        -rentals: ArrayList~Rental~\n        +addVehicle(v: Vehicle) void\n        +findVehicleById(id: String) Vehicle\n        +searchVehicle(vehicleId: String) void\n        +searchVehicle(brand: String, model: String) void\n        +displayAllVehicles() void\n        +displayAvailableVehicles() void\n        +displayRentedVehicles() void\n        +updateVehiclePrice(vehicleId: String, newPrice: double) void\n        +addCustomer(c: Customer) void\n        +findCustomerById(id: String) Customer\n        +displayAllCustomers() void\n        +updateCustomerPhone(customerId: String, phone: String) void\n        +updateCustomerEmail(customerId: String, email: String) void\n        +rentVehicle(customerId: String, vehicleId: String, days: int, optional: boolean) Rental\n        +returnVehicle(rentalId: int) void\n        +displayAllRentals() void\n        +displayActiveRentals() void\n        +displayCustomerHistory(customerId: String) void\n        +getTotalRevenue() double\n        +flagVehicleForMaintenance(vehicleId: String) void\n        +displayVehiclesNeedingMaintenance() void\n        +performMaintenance(vehicleId: String) void\n        -hasActiveRental(v: Vehicle) boolean\n    }\n\n    class Vehicle {\n        &lt;&lt;abstract&gt;&gt;\n        -vehicleId: String\n        -brand: String\n        -model: String\n        -year: int\n        -dailyPrice: double\n        -available: boolean\n        -maintenanceRequired: boolean\n        -totalVehiclesCreated: int$\n        +Vehicle(id, brand, model, year, dailyPrice, available)\n        +Vehicle(id, brand, model, year, dailyPrice)\n        +getVehicleId() String\n        +getBrand() String\n        +getModel() String\n        +getYear() int\n        +getDailyPrice() double\n        +isAvailable() boolean\n        +isMaintenanceRequired() boolean\n        +getTotalVehiclesCreated() int$\n        +setDailyPrice(price: double) void\n        +setAvailable(available: boolean) void\n        +flagForMaintenance() void\n        #clearMaintenanceFlag() void\n        #calculateBaseCost(days: int) double\n        #displayCommonInfo() void\n        +calculateRentalCost(days: int, optionalService: boolean) double*\n        +displayInfo() void*\n        +getOptionalServiceName() String*\n    }\n\n    class Maintainable {\n        &lt;&lt;interface&gt;&gt;\n        +performMaintenance() void\n        +needsMaintenance() boolean\n    }\n\n    class Car {\n        +INSURANCE_PER_DAY: double$\n        -seats: int\n        -transmission: String\n        +Car(id, brand, model, year, price, seats, transmission)\n        +Car(id, brand, model, year, price)\n        +getSeats() int\n        +getTransmission() String\n        +calculateRentalCost(days: int, optionalService: boolean) double\n        +displayInfo() void\n        +getOptionalServiceName() String\n        +performMaintenance() void\n        +needsMaintenance() boolean\n    }\n\n    class Motorcycle {\n        +HELMET_PER_DAY: double$\n        -engineCC: int\n        -helmetAvailable: boolean\n        +Motorcycle(id, brand, model, year, price, engineCC, helmet)\n        +Motorcycle(id, brand, model, year, price, engineCC)\n        +getEngineCC() int\n        +isHelmetAvailable() boolean\n        +calculateRentalCost(days: int, optionalService: boolean) double\n        +displayInfo() void\n        +getOptionalServiceName() String\n        +performMaintenance() void\n        +needsMaintenance() boolean\n    }\n\n    class Truck {\n        +SERVICE_FEE: double$\n        -maxLoadTons: double\n        +Truck(id, brand, model, year, price, maxLoadTons)\n        +getMaxLoadTons() double\n        +calculateRentalCost(days: int, optionalService: boolean) double\n        +displayInfo() void\n        +getOptionalServiceName() String\n        +performMaintenance() void\n        +needsMaintenance() boolean\n    }\n\n    class Customer {\n        -customerId: String\n        -fullName: String\n        -phone: String\n        -email: String\n        -licenseNumber: String\n        +Customer(id, fullName, phone, email, license)\n        +getCustomerId() String\n        +getFullName() String\n        +getPhone() String\n        +getEmail() String\n        +getLicenseNumber() String\n        +setPhone(phone: String) void\n        +setEmail(email: String) void\n        +displayInfo() void\n    }\n\n    class Rental {\n        +ACTIVE: String$\n        +COMPLETED: String$\n        -nextRentalId: int$\n        -rentalId: int\n        -customer: Customer\n        -vehicle: Vehicle\n        -days: int\n        -totalCost: double\n        -status: String\n        +Rental(customer, vehicle, days, totalCost)\n        +getRentalId() int\n        +getCustomer() Customer\n        +getVehicle() Vehicle\n        +getDays() int\n        +getTotalCost() double\n        +getStatus() String\n        +isActive() boolean\n        +complete() void\n        +displayInfo() void\n    }\n\n    class RentalException {\n        +RentalException(message: String)\n    }\n\n    class Exception\n\n    Vehicle &lt;|-- Car\n    Vehicle &lt;|-- Motorcycle\n    Vehicle &lt;|-- Truck\n    Maintainable &lt;|.. Car\n    Maintainable &lt;|.. Motorcycle\n    Maintainable &lt;|.. Truck\n    Exception &lt;|-- RentalException\n\n    Main ..&gt; RentalSystem : uses\n    RentalSystem ..&gt; RentalException : throws\n\n    RentalSystem o-- \&quot;0..*\&quot; Vehicle\n    RentalSystem o-- \&quot;0..*\&quot; Customer\n    RentalSystem o-- \&quot;0..*\&quot; Rental\n\n    Rental \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Customer\n    Rental \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Vehicle&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="zAUsYy1n38PodfZ1fqXd-182">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
